# Copy to .env and fill in real values (never commit .env)
PORT=5000

# Neon shared database. Get both strings from the team (private chat only).
# DATABASE_URL = pooled (host contains -pooler); DIRECT_URL = same host without -pooler.
# Do NOT include channel_binding=require (Prisma cannot connect with it).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Local PostgreSQL instead (offline work): use the same URL for both
# DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/foodrescue"
# DIRECT_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/foodrescue"

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Separate long random secret for the pickup/delivery codes (required in production,
# must differ from JWT_SECRET). The WHOLE TEAM must use the same value on the shared
# database, otherwise codes shown on one laptop will not verify on another.
# OTP_SECRET=
# Admin demo tools (concurrency demo, simulate expiry): on by default except in production
# ENABLE_DEMO_TOOLS=true
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
