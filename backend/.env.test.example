# Automated tests use a LOCAL database so they never touch the shared Neon data.
# Each teammate: create the database once (CREATE DATABASE foodrescue_test;) and
# put your own local postgres password below.
NODE_ENV=test
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/foodrescue_test"
DIRECT_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/foodrescue_test"
JWT_SECRET=test-secret-that-is-long-enough-1234567890
JWT_EXPIRES_IN=1h
CLIENT_URL=http://localhost:5173
MATCHING_AUTORUN=off
